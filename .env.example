# ============================================================================
# Пример конфигурации. Скопируйте этот файл в .env и при желании измените
# значения. РЕАЛЬНЫХ ключей здесь нет и быть не должно: по умолчанию система
# работает с детерминированным mock-квалификатором и не требует ни одного
# внешнего API. Ключ DeepSeek нужен только для переключения на живую модель.
# ============================================================================

# --- База данных (поднимается docker-compose; менять не нужно) ---
POSTGRES_USER=athenai
POSTGRES_PASSWORD=athenai_dev
POSTGRES_DB=athenai

# --- Квалификатор лидов: mock | deepseek ---
QUALIFIER_PROVIDER=mock

# --- DeepSeek (OpenAI-совместимый API). Оставьте пустым для mock-режима ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30

# --- Токены доступа. Значения ниже — очевидные локальные заглушки:
#     защищают эндпоинты в демо-развёртывании и НЕ являются секретами. ---
WEBHOOK_TOKEN_TELEGRAM=dev-token-telegram
WEBHOOK_TOKEN_WEBSITE=dev-token-website
WEBHOOK_TOKEN_AVITO=dev-token-avito
ADMIN_TOKEN=dev-admin-token
MOCK_CRM_TOKEN=dev-crm-token

# --- Поведение конвейера ---
WORKER_POLL_INTERVAL_SECONDS=2
CRM_RETRY_MAX_ATTEMPTS=5
CRM_BACKOFF_BASE_SECONDS=1
CRM_BACKOFF_MAX_SECONDS=60
LLM_MAX_ATTEMPTS=2
